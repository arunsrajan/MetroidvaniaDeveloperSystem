[sub_resource type="GDScript" id="GDScript_4c0to"]
script/source = "@tool
extends Area2D
signal demo_completed
func _ready() -> void:
	body_entered.connect(func(b: Node) -> void:
		if b.is_in_group(&\"player\"):
			set_meta(&\"demo_completed\", true)
			demo_completed.emit()
			var game := MDSWorldGame.instance
			if game:
				var kit := MDSGameplay.find(game)
				if kit:
					kit.notice.emit(\"Demo Completed! Thank you for playing!\"))
"

