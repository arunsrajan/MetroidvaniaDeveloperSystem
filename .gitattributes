# Normalize line endings for all text files.
* text=auto eol=lf

# Downloads (GitHub archives, `git archive`, Godot Asset Store and Asset Library zips) contain
# only the addon and the optional Mossgrove and Sunken Gardens asset packs, not the demo
# project, tests, docs or examples.
/**                export-ignore
/addons            !export-ignore
/addons/**         !export-ignore
/asset_packs       !export-ignore
/asset_packs/**    !export-ignore
graphify-out/graph.json merge=graphify
